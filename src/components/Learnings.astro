---
interface Props {
	learnings: string[];
}

const { learnings } = Astro.props;
---

<section class="learnings" aria-labelledby="learnings-heading">
	<div class="learnings__shape">
		<svg viewBox="0 0 100 100" aria-hidden="true">
			<polygon
				points="50,5 95,95 5,95"
				fill="none"
				stroke="currentColor"
				stroke-width="1"
				stroke-dasharray="5.022 5.022"
				stroke-linecap="round"
				stroke-linejoin="round"
				vector-effect="non-scaling-stroke"
			/>
		</svg>
		<h2 class="learnings__label" id="learnings-heading">Learnings</h2>
	</div>

	<ol class="learnings__list">
		{
			learnings.map((item) => (
				<li>
					{item}
					<svg class="learnings__line" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<line
							x1="0"
							y1="0.5"
							x2="100%"
							y2="0.5"
							stroke="currentColor"
							stroke-width="1"
							stroke-dasharray="5 5"
							stroke-linecap="round"
						/>
					</svg>
				</li>
			))
		}
	</ol>
</section>

<style>
	.learnings {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 3rem;
		margin-block: 4rem 6rem;
	}

	.learnings__shape {
		position: relative;
		flex: 0 0 clamp(140px, 15vw, 180px);
		color: var(--color-text);
	}

	.learnings__shape svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.learnings__label {
		position: absolute;
		inset: 0;
		display: flex;
		/* sit in the wide lower part of the triangle, not its geometric middle */
		align-items: flex-end;
		justify-content: center;
		padding-bottom: 18%;
		margin: 0;
		font-size: 1rem;
		font-weight: 500;
	}

	.learnings__list {
		flex: 0 1 48rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: learnings;
	}

	.learnings__list li {
		position: relative;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
		padding-bottom: 0.5rem;
		font-size: 1rem;
		counter-increment: learnings;
	}

	.learnings__list li::before {
		content: counter(learnings) '.';
		font-weight: 600;
	}

	.learnings__line {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 1px;
		overflow: visible;
		pointer-events: none;
		color: var(--color-text);
	}

	@media (max-width: 640px) {
		.learnings {
			flex-direction: column;
			gap: 2rem;
		}

		.learnings__shape {
			flex: none;
			width: 160px;
		}

		.learnings__list {
			flex-basis: auto;
			width: 100%;
		}
	}
</style>
