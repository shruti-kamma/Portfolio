---
import ToolIcons from './ToolIcons.astro';
import Button from './Button.astro';
import { toBlocks } from '../data/text';
import type { Tool } from '../data/projects';

interface Props {
	context: string;
	scope: string;
	duration: string;
	role: string;
	liveUrl?: string;
	tools: Tool[];
}

const { context, scope, duration, role, liveUrl, tools } = Astro.props;

const blocks = toBlocks(context);
---

<section class="project-meta">
	<div class="project-meta__context">
		{blocks.map((block) => (block.type === 'p' ? <p>{block.text}</p> : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>))}
		{
			liveUrl && (
				<div class="project-meta__live">
					<Button href={liveUrl}>Visit live site ↗</Button>
				</div>
			)
		}
	</div>

	<dl class="project-meta__facts">
		<div class="project-meta__row">
			<dt>Scope:</dt>
			<dd>{scope}</dd>
		</div>
		<div class="project-meta__row">
			<dt>Duration:</dt>
			<dd>{duration}</dd>
		</div>
		<div class="project-meta__row">
			<dt>Role:</dt>
			<dd>{role}</dd>
		</div>
		<div class="project-meta__row project-meta__row--tools">
			<dt>Tools:</dt>
			<dd><ToolIcons tools={tools} /></dd>
		</div>
	</dl>
</section>

<style>
	.project-meta {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 2rem;
		padding: 1.5rem;
		margin-bottom: 3rem;
	}

	.project-meta__context {
		font-size: 1rem;
	}

	.project-meta__context p,
	.project-meta__context ul {
		margin: 0 0 1rem;
	}

	.project-meta__context > :last-child {
		margin-bottom: 0;
	}

	.project-meta__live {
		padding-top: 0.25rem;
	}

	.project-meta__facts {
		margin: 0;
		padding-left: 2rem;
		border-left: 1px solid var(--color-text);
		font-size: 1rem;
	}

	.project-meta__row {
		display: flex;
		/* label lines up with the first line of a value that wraps */
		align-items: baseline;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.project-meta__row:last-child {
		margin-bottom: 0;
	}

	.project-meta__row--tools {
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.project-meta__row dt {
		font-weight: 600;
	}

	.project-meta__row dd {
		margin: 0;
	}

	@media (max-width: 768px) {
		.project-meta {
			grid-template-columns: 1fr;
			padding: 0;
		}

		.project-meta__facts {
			padding: 1.5rem 0 0;
			border-left: none;
			border-top: 1px solid var(--color-text);
		}
	}
</style>
