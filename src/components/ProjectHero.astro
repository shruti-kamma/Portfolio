---
import type { ImageMetadata } from 'astro';
import FramedImage from './FramedImage.astro';

interface Props {
	title: string;
	image?: ImageMetadata;
}

const { title, image } = Astro.props;
---

<div class="project-hero">
	<FramedImage src={image} alt="" solid sizes="(max-width: 1280px) 100vw, 1184px" priority>
		<h1 class="project-hero__title">{title}</h1>
	</FramedImage>
</div>

<style>
	.project-hero {
		height: calc(100vh - 120px);
		margin-bottom: 2rem;
	}

	@media (max-width: 640px) {
		.project-hero {
			height: auto;
			aspect-ratio: 4 / 5;
		}

		.project-hero__title {
			font-size: 1.75rem;
		}
	}

	.project-hero__title {
		position: absolute;
		left: 1.5rem;
		bottom: 1.5rem;
		z-index: 1;
		margin: 0;
		font-size: 2.25rem;
		font-weight: 500;
		line-height: 1;
		color: var(--card-accent-on);
	}
</style>
