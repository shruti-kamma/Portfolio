---
import type { ImageMetadata } from 'astro';
import FramedImage from './FramedImage.astro';
import { toBlocks } from '../data/text';

interface Props {
	number: number;
	problem: string;
	description: string;
	image?: ImageMetadata;
	imageSide: 'left' | 'right';
}

const { number, problem, description, image, imageSide } = Astro.props;
const blocks = toBlocks(description);
---

<div class={`process-step process-step--image-${imageSide}`}>
	<div class="process-step__image">
		<FramedImage src={image} alt="" solid sizes="(max-width: 640px) 100vw, 520px">
			<span class="process-step__number">{number}.</span>
		</FramedImage>
	</div>
	<div class="process-step__text">
		<h3 class="process-step__problem">{problem}:</h3>
		<div class="process-step__description">
			{blocks.map((block) => (block.type === 'p' ? <p>{block.text}</p> : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>))}
		</div>
	</div>
</div>

<style>
	.process-step {
		display: grid;
		grid-template-columns: 5fr 7fr;
		gap: 2rem;
		/* the image box stretches to the text's height, so both columns end level */
		align-items: stretch;
		margin-bottom: 3rem;
	}

	.process-step__image {
		grid-column: 1;
		grid-row: 1;
		min-height: 260px;
	}

	.process-step__text {
		grid-column: 2;
		grid-row: 1;
		align-self: center;
	}

	.process-step--image-right {
		grid-template-columns: 7fr 5fr;
	}

	.process-step--image-right .process-step__image {
		grid-column: 2;
	}

	.process-step--image-right .process-step__text {
		grid-column: 1;
	}

	.process-step__number {
		position: absolute;
		right: 1rem;
		bottom: 0.75rem;
		z-index: 1;
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--card-accent-on);
	}

	.process-step__problem {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.process-step__description {
		font-size: 1rem;
		line-height: 1.5;
	}

	.process-step__description p,
	.process-step__description ul {
		margin: 0 0 0.75rem;
	}

	.process-step__description ul {
		padding-left: 1.25rem;
	}

	.process-step__description li {
		margin-bottom: 0.25rem;
	}

	.process-step__description > :last-child {
		margin-bottom: 0;
	}

	@media (max-width: 640px) {
		.process-step,
		.process-step--image-right {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.process-step .process-step__image,
		.process-step .process-step__text {
			grid-column: 1;
			grid-row: auto;
		}

		.process-step__image {
			min-height: 0;
			aspect-ratio: 4 / 3;
		}
	}
</style>
